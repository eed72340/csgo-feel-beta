<Window x:Class="CSGORestore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CSGORestore"
        Title="CS:GO 手感还原器 | cl_bob / viewmodel_recoil / cs_go_shangyang"
        Height="880" Width="1360" MinHeight="720" MinWidth="1120"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="5" Height="32" CornerRadius="3" Background="{StaticResource Accent}" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="CS:GO 手感还原器" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="cl_bob 全指令 · viewmodel_recoil · 自研 cs_go_shangyang"
                               FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="复制指令" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Copy_Click"/>
                <Button Content="导出 .cfg" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="Export_Click"/>
                <Button Content="重置" Style="{StaticResource GhostButton}" Click="Reset_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="404"/>
            </Grid.ColumnDefinitions>

            <!-- 预览 -->
            <Border Grid.Column="0" CornerRadius="12" Background="#05070B"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True"
                    MouseLeftButtonDown="Preview_MouseDown"
                    MouseLeftButtonUp="Preview_MouseUp"
                    MouseLeave="Preview_MouseLeave">
                <Grid>
                    <local:ViewmodelView x:Name="Preview"/>
                </Grid>
            </Border>

            <!-- 指令面板 -->
            <Border Grid.Column="1" Margin="14,0,0,0" CornerRadius="12"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="16,14,16,8">
                        <TextBlock Text="预设" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2">
                            <Button Content="CS:GO 默认" Style="{StaticResource GhostButton}" FontSize="11.5"
                                    Padding="8,7" Margin="0,0,5,5" Click="PresetCsgo_Click"/>
                            <Button Content="职业哥 · 静音晃动" Style="{StaticResource GhostButton}" FontSize="11.5"
                                    Padding="8,7" Margin="0,0,0,5" Click="PresetPro_Click"/>
                            <Button Content="CS2 原生晃动" Style="{StaticResource GhostButton}" FontSize="11.5"
                                    Padding="8,7" Margin="0,0,5,0" Click="PresetCs2_Click"/>
                            <Button Content="夸张演示" Style="{StaticResource GhostButton}" FontSize="11.5"
                                    Padding="8,7" Click="PresetCrazy_Click"/>
                        </UniformGrid>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,4"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,6,10,0">
                        <StackPanel x:Name="CvarHost"/>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" Margin="16,10,16,12" TextWrapping="Wrap" FontSize="10.5"
                               Foreground="{StaticResource Muted}" LineHeight="16"
                                Text="这是近似可视化，不是原引擎复刻。legacy 本地配置：lat 0.33 / vert 0.14。CS2 不会执行已移除的 cl_bob 指令；客户端需本机服务端遥测。"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 控制台 ================= -->
        <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="10"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                Padding="14,10,14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="ConsoleLog" Style="{StaticResource DarkTextBox}" IsReadOnly="True"
                         BorderThickness="0" Background="Transparent" Padding="0" Height="86"
                         FontSize="11.5" Foreground="#AEB8C9" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>

                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="›" Margin="0,0,8,0" FontSize="15"
                               FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="ConsoleInput" Style="{StaticResource DarkTextBox}" Height="34"
                             FontSize="12" KeyDown="ConsoleInput_KeyDown"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
