<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>csgo-feel-plugintest</AssemblyName>
    <RootNamespace>PluginTest</RootNamespace>
    <!-- 插件标了 SupportedOSPlatform("windows")（用了共享内存），
         这个离线测试只调用纯文本生成函数，不需要跟着刷平台警告 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 服务端工程把 API 包标成 Private=false（部署时不该带），
         这里单独再引一次，好让测试程序能真正加载 CounterStrikeSharp.API。 -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.377" />
    <ProjectReference Include="..\..\server\CSGOFeel.csproj" />
  </ItemGroup>

</Project>
